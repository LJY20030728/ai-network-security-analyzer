.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
venv_broken/
installer_output/
installer_test/
_build_log.txt
# 打包/调试临时产物（仅在仓库根目录生效）
# 注意：不加前导斜杠会让 `_*.py` 匹配到 **所有** `__init__.py`
# （basename 以 `_` 开头），导致全部包初始化文件从未入库 —— 新 clone 缺包结构。
/_*.log
/_*.py

# Large files - training data (not suitable for GitHub, download separately)
data/eval_cicids/csv/*.csv
data/eval_cicids/csv/*.zip

# Large files - BGE embedding model (~90MB, download via tools/init_resources.py)
models/bge-small-zh-v1.5/

# Large files - MITRE ATT&CK knowledge base (~51MB, download via tools/init_resources.py)
data/knowledge/mitre_attck/

# Large files - real evaluation data (large PCAP, not suitable for GitHub)
data/eval_real/

# Old packaging files and temporary files
*.zip
_err*.png
_time_ref*.png
demo_analysis.py
test_quick.py
test_zhipu_api.py
# 注：`run.py` 与 `*.spec` 原先在此被忽略，但二者都是构建/运行入口：
#   - run.py 是 README「方式一」的 API 启动入口
#   - AI网络安全分析系统.spec 是 PyInstaller 打包配置
# 被忽略会导致 clone 后缺少入口文件，故已移出忽略列表并纳入版本控制。

# 运行期/构建期残留（此前未忽略，导致仓库内堆积 660MB 垃圾）
# 注：.gitignore 不支持行尾注释——`pattern  # 注释` 会被整体当作模式，
# 导致规则静默失效。以下注释一律独占一行。
# Gradio 上传与缓存目录
gradio/
# pythonnet 运行时配置（生成物）
*.runtimeconfig.json
.pytest_cache/
__pycache__/
.coverage
htmlcov/

# PyInstaller 中间产物与锁文件（blat 为 4 字节锁）
*.manifest
warn-*.txt
xref-*.html
# pyinstaller 在仓库根留下的 8 字符无名临时文件
# 注：gitignore 不支持 `{n}` 量词（`/[0-9a-z_]{8}` 实测从不匹配），
# 但支持 `?` 单字符通配，故用 8 个 `?`。
/????????
/tmp*
/pip-*
/pytest-of-*
# pytest --basetemp 目录（见 pyproject.toml 的 [tool.pytest.ini_options] 说明）
/.pytest_tmp/

# Temporary files
*.tmp
*.bak
*.bak_*

# Temporary report JSON files generated during testing
data/samples/report_*.json
data/samples/regression_result.json

# Persisted analyzed PCAP files (copied at runtime)
data/samples/analyzed/

build_log*.txt

# 评测脚本生成的临时样本（verify_baseline_value.py 默认写这里，不改动 golden）
data/samples/generated/

# 测试残留数据库文件
_test_*.db
_test_*.db-journal
