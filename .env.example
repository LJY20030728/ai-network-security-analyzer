# ============================================================
# 大模型API配置 - 支持多个免费平台，任选其一
# ============================================================

# ===== 方案1：硅基流动 SiliconFlow（⭐推荐，免费额度充足） =====
# 官网: https://siliconflow.cn/
# 注册送¥14额度，Qwen2.5-7B等小模型永久免费
# 国内直连，速度快，兼容OpenAI接口
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 硅基流动其他可选模型（免费）：
# LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# LLM_MODEL=deepseek-ai/DeepSeek-V2.5
# LLM_MODEL=THUDM/glm-4-9b-chat
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ===== 方案2：智谱AI BigModel（GLM-4-Flash永久免费） =====
# 官网: https://www.bigmodel.cn/
# GLM-4-Flash / GLM-4.5-Flash 永久免费，新用户送2000万Token
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ===== 方案3：DeepSeek（便宜，注册送额度） =====
# 官网: https://platform.deepseek.com/
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ===== 方案4：通义千问（阿里云百炼，有免费额度） =====
# 官网: https://bailian.console.aliyun.com/
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo

# ===== 方案5：Ollama本地模型（完全免费，无需API Key） =====
# 安装: https://ollama.com/download
# 运行: ollama run qwen2.5:7b
# LLM_API_KEY=ollama（任意值即可）
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ===== Embedding模型（本地运行，无需API，首次自动下载） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============================================================
# 项目配置
# ============================================================
PROJECT_NAME=AI Network Security Analyzer
DEBUG=true
LOG_LEVEL=INFO

# ===== 抓包配置 =====
# 默认抓包网卡（留空则自动选择）
CAPTURE_INTERFACE=
# 抓包过滤规则（BPF语法，和Wireshark完全一致）
CAPTURE_FILTER=tcp or udp or icmp
# 单次抓包数量上限
CAPTURE_PACKET_LIMIT=1000

# ===== 数据库配置 =====
# ChromaDB向量数据库持久化路径
CHROMA_PERSIST_DIR=./data/chroma_db
