# Runtime data (generated at startup, do not commit)
data/db/
data/history/
data/uploads/
data/chroma_db/
data/reports/
data/audit/
data/logs/
data/config/
*.log
logs/

# Runtime-generated baselines (user-learned)
data/baselines/*.json
# 预置默认基线随安装包分发，必须入库（CI 依赖此文件）
!data/baselines/default_baseline.json
!data/baselines/base-attack.json

